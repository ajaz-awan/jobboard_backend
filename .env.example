NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/jobboard
UPLOAD_DIR=./uploads
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
JWT_ISSUER=jobboard-api
JWT_AUDIENCE=jobboard-client
TRUST_PROXY_HOPS=0
REFRESH_TOKEN_DAYS=7
# Development writes email previews to this private folder; production requires SMTP.
MAIL_TRANSPORT=outbox
MAIL_OUTBOX_DIR=./.mail-outbox
MAIL_FROM=noreply@jobboard.local
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# Local development defaults; no S3/ClamAV account needed.
STORAGE_DRIVER=local
MALWARE_SCAN=none
RATE_LIMIT_STORE=memory
LOG_REQUESTS=false
UPLOAD_CONCURRENCY=8
# Production configuration is documented in .env.production.example.
