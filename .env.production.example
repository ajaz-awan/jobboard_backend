NODE_ENV=production
PORT=5000
CLIENT_URL=https://jobs.your-domain.com
MONGODB_URI=mongodb://app-user:percent-encoded-password@private-mongo-host:27017/jobboard?authSource=jobboard
JWT_SECRET=replace-with-a-random-96-character-hex-secret
JWT_EXPIRES_IN=15m
JWT_ISSUER=jobboard-api
JWT_AUDIENCE=jobboard-client
REFRESH_TOKEN_DAYS=7
MAIL_TRANSPORT=smtp
MAIL_FROM=noreply@your-domain.com
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=replace-smtp-user
SMTP_PASS=replace-smtp-password
STORAGE_DRIVER=s3
S3_REGION=us-east-1
S3_BUCKET=your-private-bucket
S3_KEY_PREFIX=jobboard
# Prefer an IAM role when supported; otherwise configure a least-privilege access key.
# S3_ACCESS_KEY_ID=replace-access-key
# S3_SECRET_ACCESS_KEY=replace-secret
# For S3-compatible services:
# S3_ENDPOINT=https://your-object-storage-endpoint
# S3_FORCE_PATH_STYLE=true
MALWARE_SCAN=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
UPLOAD_CONCURRENCY=8
RATE_LIMIT_STORE=mongo
LOG_REQUESTS=true
TRUST_PROXY_HOPS=1
UPLOAD_DIR=/app/uploads
# Compose only: generate separate hex passwords to avoid URI reserved-character mistakes.
MONGO_ROOT_PASSWORD=replace-with-random-hex-root-password
MONGO_APP_USER=jobboard_app
MONGO_APP_PASSWORD=replace-with-a-different-random-hex-password
